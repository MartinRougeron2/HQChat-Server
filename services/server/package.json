{
  "name": "hqchat-server",
  "version": "1.0.0",
  "description": "The server half of hqchat: HQC-KEM handshake, per-topic ACL, push bridge. It never sees a message.",
  "scripts": {
    "auth": "tsx auth/main.ts",
    "api": "tsx api/main.ts",
    "push": "tsx push/main.ts",
    "broker-watch": "tsx ops/broker-watch.ts",
    "bot": "tsx bot/bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts legacy/secure-transport.test.ts",
    "test:e2e": "node --import tsx --test legacy/e2e.test.ts legacy/account-delete.e2e.test.ts",
    "legacy:server": "tsx legacy/server.ts",
    "legacy:stress": "tsx legacy/stress.ts",
    "migrate": "tsx services/db/migrate.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinRougeron2/HQChat-Server.git"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@sentry/node": "^8.55.2",
    "dotenv": "^17.2.3",
    "koffi": "^2.15.0",
    "mqtt": "^5.15.2",
    "pg": "^8.13.1",
    "stripe": "^17.5.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ffi-napi": "^4.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@types/ref-napi": "^3.0.12",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
