# Non-secret server config.
#
# DOCKER (recommended, see deploy/docker-compose.yml): copy this to
#   deploy/server.env  and fill in ONLY the non-secret values. The actual
#   secrets (Stripe keys, database URL, APNs key, bot seed) are NOT put here —
#   they go in plain files under deploy/secrets/ and are injected as compose
#   secrets, then read via the *_FILE env vars wired up in docker-compose.yml.
#   Lines below tagged "[secret → deploy/secrets/...]" should be left blank here.
#
# PM2 / bare-metal: copy this to server/messages/.env and fill in everything
#   (including the secrets inline). Never commit the real file.

# --- Server identity --------------------------------------------------------
# Shown at /info so clients can validate the URL before connecting.
SERVER_NAME=DissQus
# Public origin used for Stripe redirect URLs and links (no trailing slash).
PUBLIC_BASE_URL=https://chat.example.com

# Server
PORT=8080

# --- Admission policy -------------------------------------------------------
# Who may use this server once authenticated (HQC challenge always applies):
#   open      — anyone (the default, and what the official server runs)
#   allowlist — only the public keys in ADMISSION_ALLOWLIST (private servers)
#
# There used to be a third, `stripe`, where a paid door required a subscription
# claimed by email. The product is free and donation-funded now, so payment has
# no say in admission — see DONATIONS_ENABLED below. A host still carrying
# ADMISSION_POLICY=stripe will REFUSE TO BOOT rather than silently fall back to
# `open`, which is a change worth knowing about before a deploy.
ADMISSION_POLICY=open
# Comma-separated hex PUBLIC KEYS (14474 characters each), used when
# ADMISSION_POLICY=allowlist. Keys, not client ids: a key is what an operator
# actually has in front of them, and the server reduces each entry to the id it
# names before comparing (lib/admission.ts). Case does not matter.
ADMISSION_ALLOWLIST=
# Public keys that always bypass the admission policy (e.g. the helper bot).
# Same form as ADMISSION_ALLOWLIST. The helper bot registers ITSELF in the
# database at startup, so this is an override for a key you cannot ask to do
# that — leaving it empty is normal.
EXEMPT_PUBLIC_KEYS=

# --- Helper bot (optional) --------------------------------------------------
BOT_USERNAME=helper
# Fixed 32-byte hex seed so the bot's identity is stable across redeploys.
# (If unset, the bot generates one in bot/.bot-seed on first run — under Docker
# this is persisted in the bot-state volume, so the identity survives restarts.)
#   [secret → deploy/secrets/bot_seed, optional]
BOT_SEED=

# --- Observability: Sentry + logging ----------------------------------------
# Sentry crash reporting + the crash early-warning monitor (lib/health-monitor.ts).
# The DSN is a send-only client token, so it is NOT a secret; leave it blank to
# disable Sentry entirely (the process crash handlers stay active regardless).
#
# ⚠️ This used to say "in Docker the DSN is already set in docker-compose.yml —
# only set it here for PM2/bare-metal". That was false, and it is the reason a
# host can run with Sentry off everywhere and nobody notice: the compose file
# deliberately declares NO `environment:` entry for SENTRY_DSN (an `environment:`
# entry overrides `env_file`, which is what silently blanked MAIL_FROM — see the
# comment at the top of docker-compose.yml). So env_file is the only path, and if
# neither release.env nor server.env sets it, Sentry is disabled.
#
# ONE DSN serves all six server services: initObservability() tags every event
# with its component (server | bot | auth | api | push-bridge | broker-watch),
# and SENTRY_ENVIRONMENT — declared per stack in compose — separates prod from
# preprod. The Apple apps carry their own DSN, via Info.plist.
#
# Preferred home: a GitHub repository variable, baked into release.env like the
# APNS_* values. Set it here only to override for this stack — or if the GHCR
# package is public, since release.env ships inside the image and a readable DSN
# lets anyone post events into the project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# LOG_LEVEL controls what reaches stdout/Docker logs: silent|error|warn|info|debug.
# Default "info" in production = startup + real errors only (per-message chatter is
# at "debug"). Errors/warnings still go to Sentry regardless of this level.
LOG_LEVEL=info
# Crash early-warning thresholds — override the defaults in lib/health-monitor.ts.
# Tune these from `npm run stress` output (it prints refined values it observed).
# HEALTH_LOOP_WARN_MS=100
# HEALTH_LOOP_CRIT_MS=500
# HEALTH_RSS_WARN_MB=700
# HEALTH_RSS_CRIT_MB=900
# HEALTH_CLIENTS_WARN=4000
# HEALTH_CLIENTS_CRIT=8000
# Require a bearer token to read /metrics (recommended if exposed beyond localhost).
# METRICS_TOKEN=

# --- Postgres ---------------------------------------------------------------
# The whole backing store. Docker: leave DATABASE_URL blank — the compose file
# sets DATABASE_URL_FILE=/run/secrets/database_url.
#
# PROD: produced by `terraform output` in infra/database (a managed cluster).
# PRE-PROD: generated by `set-host-secrets.sh preprod`, pointing at the postgres
#   container that stack runs on its own host. Pre-prod is deliberately NOT on
#   the production cluster — see infra/database/README.md.
#   [secret → deploy/secrets/database_url]        pooler endpoint, the services
#   [secret → deploy/secrets/database_url_direct] direct endpoint, migrations
#   [secret → deploy/secrets/pg_ca_cert]          cluster CA, for verify-full
# Bare-metal / local: set the full URL here instead.
DATABASE_URL=

# EMQX reads the topic ACL itself, with its OWN read-only role. It cannot take a
# URI, and it must not read this file: EMQX treats every EMQX_*/known-root env
# var as a config override, so an unrecognised one is a boot failure. Its four
# connection fields therefore live together in ONE secret file, shaped as shell
# assignments, which the container sources before rendering emqx.conf.
#   [secret → deploy/secrets/emqx_pg]
#     AUTHZ_PG_SERVER=private-....db.ondigitalocean.com:25061
#     AUTHZ_PG_DATABASE=hqcat_prod
#     AUTHZ_PG_USERNAME=emqx_prod
#     AUTHZ_PG_PASSWORD=...

# Which database roles the migration runner grants to (terraform output
# app_roles). Non-secret: they are names, and the grants they receive are in
# services/db/migrations/000_roles.sql.
APP_ROLE=
EMQX_ROLE=

# --- Donations (Stripe) -----------------------------------------------------
# The app is free on every platform and nothing is sold anywhere, in it or out
# of it. A donation grants NO feature, is never looked up again, and is not
# linked to any account. Independent of ADMISSION_POLICY on purpose: money has
# nothing to do with who is admitted.
#
# Leave DONATIONS_ENABLED unset on a self-hosted stack and no Stripe key is
# needed; /donate, /supporters and /stripe/webhook are simply not served.
DONATIONS_ENABLED=

# Docker: leave the two secrets blank here; put the values in the secret files.
#   [secret → deploy/secrets/stripe_secret_key]
#   [secret → deploy/secrets/stripe_webhook_secret]
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from the Stripe webhook endpoint you create

# Recurring donation tiers, comma-separated, LOW TO HIGH — that is the order the
# donate page renders them in.
#
# OPTIONAL. These are an OVERRIDE: the official deployment's Prices (product
# prod_VASN9Qoe1usGwM — €2, €5 and €15 per month) are compiled into
# services/server/lib/donations-config.ts, and a host that says nothing here
# charges those. Set it to point a fork at its own Stripe account.
#
# It did not used to have a default, on the reasoning that unset "simply means
# the monthly buttons are not offered". Nothing in the server can un-offer a
# button — the donate page is a static Worker that renders all of them
# regardless — so unset meant every button REFUSED, which is how production ran
# for days. An empty or mangled value now falls back rather than going dark;
# only a value that looks like a price id (`price_…`) overrides.
#
# ORDER IS LOAD-BEARING. The website carries display labels only, and its buttons
# post an INDEX into this list (`tier0`, `tier1`, …) rather than a price id — so
# no Stripe id appears in apps/site/ at all. That means `TIERS` in
# apps/site/src/index.js must stay the same LENGTH and the same ORDER as this
# variable: reorder one and not the other and a button charges the wrong tier.
# Two site tests guard the length and the ordering, and a server test now checks
# the site's label count against the compiled-in list; nothing can check that a
# label matches the amount Stripe actually charges.
STRIPE_DONATION_PRICE_IDS=price_1UA7SiKdAg16VdMqEwh5d0di,price_1UA7SiKdAg16VdMq6SgO0npz,price_1UA7SiKdAg16VdMqFzizTrQV

# One Price for "give once". OPTIONAL, and an override in the same way: the
# official deployment's FIXED €10 Price is compiled in.
#
# Whether the donor names the amount is a property of the Price, not of this
# config: set `custom_unit_amount` on it in Stripe and Checkout asks for a
# figure. (It has to be a Price either way — Checkout rejects
# `custom_unit_amount` on an inline `price_data`.) If you switch it, update the
# site copy too: several sentences on /donate name the €10.
STRIPE_DONATION_ONCE_PRICE_ID=price_1UA7SiKdAg16VdMqlxdkR2Ib

# The webhook needs exactly ONE event: checkout.session.completed. Do NOT
# subscribe customer.subscription.* — a lapsed recurring donation removes no
# access, because it granted none, and a handler for it could only do harm.

# --- Sentry flood control ---------------------------------------------------
# How long one distinct error is muted for after it is reported, in ms
# (default 600000 = 10 minutes). Sentry events are metered; a retry loop is not.
#
# This exists because a month's quota went on ONE condition: the bot reporting
# "could not open a session" for every peer with no prekeys yet, once per
# 15-second poll. The first occurrence of anything is always sent immediately;
# repeats of the SAME failure are counted and folded into the next one. Messages
# are fingerprinted with ids, numbers and handles collapsed, so the same fault
# about a thousand different users spends one event, not a thousand.
#
# Read per call, so it can be raised on a host that is flooding without a
# restart. 0 disables the throttle (every error billed — do not).
SENTRY_THROTTLE_MS=

# How long the broker keeps a disconnected MQTT-5 session, in seconds
# (default 3600). This IS the bot's offline queue: messages published to its
# conversations while it restarts are held for this long and delivered on
# reconnect. Setting it to 0 disables the queue entirely — on MQTT 5 that is
# also what happens if the property is simply omitted, which is how the bot ran
# for a while believing it had a queue it did not have.
MQTT_SESSION_EXPIRY_SECONDS=

# --- QoS caps ---------------------------------------------------------------
# These replaced the paywall. The bill is fixed monthly, so users cost capacity
# rather than money; what these bound is a script, not a popular account.
FRIEND_CAP=150            # contacts per account
INVITES_PER_DAY=20        # invites one account may send per day
# Per-minute ceilings on /auth/*/init, which runs an HQC encapsulation. Lowered
# when the paywall went: an unclaimed key used to be turned away for the cost of
# one lookup, so a subscription stood in front of that CPU. Nothing does now
# except these two.
AUTH_INIT_IP_LIMIT=20
AUTH_INIT_PK_LIMIT=6

# --- APNs push (optional — leave blank to disable push entirely) ------------
# From Apple Developer → Keys (create an APNs Auth Key, download the .p8).
#
# These five are NOT secrets, and GitHub owns them: set them as repository
# variables and the release workflow bakes them into the bundle (release.env)
# that every host pulls. Setting them here overrides the bundle for this stack
# alone — compose reads server.env after release.env. Only APNS_KEY_P8 is a
# secret, and it never enters GitHub.
#
# All of it, or none of it. Only push-bridge reads these, and only push-bridge
# validates them (`assertConfig(["apns"])`): it warns on a partial config —
# loudly, to Sentry — and states its verdict on every connect. It used to be checked
# in every service, which meant the two ids below — correctly placed in this
# shared file — made auth and app-api exit, because the .p8 is mounted into
# push-bridge alone. Leaving APNs unset was the only way to keep the stack up,
# and a stack that boots and never sends a push looks exactly like a healthy one.
#
# `APNS_TOPIC_IOS`/`APNS_TOPIC_MACOS` are not optional either: with a valid key
# and no topic, a push is built, addressed to nothing, and dropped in silence.
APNS_KEY_ID=ABC123DEF4
APNS_TEAM_ID=YOUR_TEAM_ID
# Paste the .p8 contents on one line with literal \n between lines.
# Docker: prefer dropping the raw .p8 at deploy/secrets/apns_key_p8 and setting
#   APNS_KEY_P8_FILE=/run/secrets/apns_key_p8 in docker-compose.yml (no escaping).
#   [secret → deploy/secrets/apns_key_p8]
APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APNS_TOPIC_IOS=martin.rougeron.DissQus-iOS      # iOS app bundle id
APNS_TOPIC_MACOS=martin.rougeron.DissQus        # macOS app bundle id
APNS_ENV=sandbox                                 # sandbox for dev/TestFlight, production for App Store
